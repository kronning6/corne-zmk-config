#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define BASE     0
#define NUMBERS  1
#define SYMBOLS  2
#define MEDIA    3

/ {
        macros {
                // Hold real modifiers so they also apply to keys pressed while held.
                hyper: hyper {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        display-name = "Hyper";
                        wait-ms = <0>;
                        bindings = <&macro_press &kp LCTRL &kp LSHFT &kp LALT &kp LGUI>,
                                   <&macro_pause_for_release>,
                                   <&macro_release &kp LGUI &kp LALT &kp LSHFT &kp LCTRL>;
                };

                meh: meh {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        display-name = "Meh";
                        wait-ms = <0>;
                        bindings = <&macro_press &kp LCTRL &kp LSHFT &kp LALT>,
                                   <&macro_pause_for_release>,
                                   <&macro_release &kp LALT &kp LSHFT &kp LCTRL>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

// Tap/Hold shows dual-role keys. ... = transparent; --- = disabled.
// Hyper = Ctrl+Shift+Opt+Cmd; Meh = Ctrl+Shift+Opt.

// 0: Base
// |   Tab   |    Q    |    W    |    E    |    R    |    T    |  |    Y    |    U    |    I    |    O    |    P    |Bksp/RCmd|
// |  LCtrl  | A/Media |    S    |    D    |    F    |    G    |  |    H    |    J    |    K    |    L    |    ;    |    '    |
// | LShift  |    Z    |    X    |    C    |    V    |    B    |  |    N    |    M    |    ,    |    .    |    /    | RShift  |
//                               |Bksp/LCmd| Esc/Opt |  Hyper  |  |Enter/Num|  Space  | Symbols |
                base_layer {
                        display-name = "Base";
                        // QMK encodes MOD_LGUI | MOD_RGUI as right GUI, not both.
                        bindings = <
    &kp TAB    &kp Q         &kp W         &kp E     &kp R  &kp T    &kp Y           &kp U     &kp I     &kp O    &kp P     &mt RGUI BSPC
    &kp LCTRL  &lt MEDIA A   &kp S         &kp D     &kp F  &kp G    &kp H           &kp J     &kp K     &kp L    &kp SEMI  &kp SQT
    &kp LSHFT  &kp Z         &kp X         &kp C     &kp V  &kp B    &kp N           &kp M     &kp COMMA &kp DOT  &kp FSLH  &kp RSHFT
                             &mt LGUI BSPC &mt LALT ESC   &hyper   &lt NUMBERS RET &kp SPACE &mo SYMBOLS
                        >;
                };

// 1: Numbers (hold Enter)
// |   ...   |    !    |    @    |    #    |    $    |    %    |  |    ^    |    &    |    *    |    (    |    )    |    _    |
// |   ...   |    1    |    2    |    3    |    4    |    5    |  |    6    |    7    |    8    |    9    |    0    |    -    |
// |   ...   |   ---   |   ---   |   ---   |   ---   |   ---   |  |   ---   |   ---   |   ...   |   ...   |   ...   |   ...   |
//                               |   ...   |   ...   |   ...   |  |   ...   |   ...   |   ...   |
                numbers_layer {
                        display-name = "Numbers";
                        // The five former RGB controls on Z through B are disabled.
                        bindings = <
    &trans  &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT    &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp UNDER
    &trans  &kp N1   &kp N2   &kp N3   &kp N4   &kp N5       &kp N6    &kp N7   &kp N8    &kp N9   &kp N0   &kp MINUS
    &trans  &none    &none    &none    &none    &none        &none     &none    &trans    &trans   &trans   &trans
                     &trans   &trans   &trans              &trans    &trans   &trans
                        >;
                };

// 2: Symbols (hold outer right thumb)
// |    `    |    ~    |   ---   |    [    |    ]    |    =    |  |   ---   |   ---   |   ---   |   ---   |   ---   |   ---   |
// |    ~    |  Pipe   |    \    |    (    |    )    |    +    |  |   ---   |   ---   |   ---   |   ---   |   ---   |   ---   |
// |   ---   |   ---   |   ---   |    {    |    }    |    -    |  |   ---   |   ---   |   ---   |   ---   |   ---   |   ---   |
//                               |Keypad 0 |    _    |    $    |  |   ...   |   ...   |   ...   |
                symbols_layer {
                        display-name = "Symbols";
                        bindings = <
    &kp GRAVE &kp TILDE &none     &kp LBKT  &kp RBKT  &kp EQUAL    &none  &none  &none  &none  &none  &none
    &kp TILDE &kp PIPE  &kp BSLH  &kp LPAR  &kp RPAR  &kp PLUS     &none  &none  &none  &none  &none  &none
    &none     &none     &none     &kp LBRC  &kp RBRC  &kp MINUS    &none  &none  &none  &none  &none  &none
                        &kp KP_N0 &kp UNDER &kp DLLR             &trans &trans &trans
                        >;
                };

// 3: Media / Nav (hold A)
// |   ---   |   ---   |   ---   |   ---   |   ---   |   ---   |  |  Prev   |PlayPause|  Next   |  Mute   |Vol Down | Vol Up  |
// |   ...   |   ...   | LShift  |   ---   |   Meh   |   ---   |  |  Left   |  Down   |   Up    |  Right  |   ---   |   ---   |
// |   ---   |   ---   |   ---   |   ---   |   ---   |   ---   |  |   ---   |   ---   |   ---   |   ---   |   ---   |   ---   |
//                               |   ...   |   ...   |   ...   |  |   ---   |   ---   |   ---   |
                media_layer {
                        display-name = "Media / Nav";
                        bindings = <
    &none   &none  &none     &none  &none &none    &kp C_PREV &kp C_PP &kp C_NEXT &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP
    &trans  &trans &kp LSHFT &none  &meh  &none    &kp LEFT   &kp DOWN &kp UP     &kp RIGHT  &none        &none
    &none   &none  &none     &none  &none &none    &none      &none    &none      &none      &none        &none
                   &trans    &trans &trans        &none      &none    &none
                        >;
                };
        };
};
